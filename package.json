{
  "name": "pi-index",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent local symbol navigation for Pi using Universal Ctags and SQLite",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./src/extension.ts"] },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
