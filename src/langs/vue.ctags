# Vue single-file components: definitions in the <script> block only.
--langdef=Vue
--map-Vue=+.vue
--kinddef-Vue=f,function,functions
--kinddef-Vue=v,variable,variables
--regex-Vue=/^[ \t]*(export[ \t]+)?(async[ \t]+)?function[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/f/{exclusive}
--regex-Vue=/^[ \t]*(export[ \t]+)?(const|let|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/{exclusive}
