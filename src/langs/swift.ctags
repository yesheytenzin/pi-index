# Swift: not a built-in Universal Ctags language.
--langdef=Swift
--map-Swift=+.swift
--kinddef-Swift=f,function,functions
--kinddef-Swift=c,class,classes
--kinddef-Swift=s,struct,structs
--kinddef-Swift=g,enum,enums
--kinddef-Swift=p,protocol,protocols
--kinddef-Swift=t,typealias,typealiases
--kinddef-Swift=v,variable,variables
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*func[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*class[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/c/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*struct[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/s/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*enum[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/g/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*protocol[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/p/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*typealias[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/t/{exclusive}
--regex-Swift=/^[ \t]*([a-zA-Z]+[ \t]+)*(var|let)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/{exclusive}
