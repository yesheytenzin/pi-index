# Svelte single-file components: definitions in the <script> block only.
--langdef=Svelte
--map-Svelte=+.svelte
--kinddef-Svelte=f,function,functions
--kinddef-Svelte=v,variable,variables
--regex-Svelte=/^[ \t]*(export[ \t]+)?(async[ \t]+)?function[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/f/{exclusive}
--regex-Svelte=/^[ \t]*(export[ \t]+)?(const|let|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/{exclusive}
