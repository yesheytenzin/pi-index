# Zig: Universal Ctags ships no Zig parser.
--langdef=Zig
--map-Zig=+.zig
--kinddef-Zig=f,function,functions
--kinddef-Zig=v,variable,variables
--kinddef-Zig=c,constant,constants
--kinddef-Zig=s,struct,structs
--kinddef-Zig=g,enum,enums
--kinddef-Zig=u,union,unions
--kinddef-Zig=t,test,tests
--regex-Zig=/^[ \t]*(pub[ \t]+)?(export[ \t]+)?(inline[ \t]+)?fn[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\4/f/{exclusive}
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*(extern[ \t]+|packed[ \t]+)?struct\b/\2/s/{exclusive}
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*(extern[ \t]+|packed[ \t]+)?enum\b/\2/g/{exclusive}
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*(extern[ \t]+|packed[ \t]+)?union\b/\2/u/{exclusive}
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=/\2/c/{exclusive}
--regex-Zig=/^[ \t]*(pub[ \t]+)?var[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*[:=]/\2/v/{exclusive}
--regex-Zig=/^[ \t]*test[ \t]+"([^"]+)"/\1/t/{exclusive}
