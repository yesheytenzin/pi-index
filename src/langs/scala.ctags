# Scala: not a built-in Universal Ctags language.
--langdef=Scala
--map-Scala=+.scala
--map-Scala=+.sc
--kinddef-Scala=f,method,methods
--kinddef-Scala=c,class,classes
--kinddef-Scala=o,object,objects
--kinddef-Scala=t,trait,traits
--kinddef-Scala=T,type,types
--kinddef-Scala=v,value,values
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*def[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f/{exclusive}
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*class[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/c/{exclusive}
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*object[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/o/{exclusive}
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*trait[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/t/{exclusive}
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*type[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/T/{exclusive}
--regex-Scala=/^[ \t]*([a-zA-Z]+[ \t]+)*(val|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/{exclusive}
